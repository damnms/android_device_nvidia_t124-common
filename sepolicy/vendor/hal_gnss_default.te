# gps.brcm (loaded by android.hardware.gnss@1.0-impl) connects to glgps over
# /dev/socket/gps and reads /data/system/gps/libgps.conf.
unix_socket_connect(hal_gnss_default, gps, gpsd)
typeattribute hal_gnss_default data_between_core_and_vendor_violators;

allow hal_gnss_default system_data_file:dir search;
allow hal_gnss_default gps_data_file:dir rw_dir_perms;
allow hal_gnss_default gps_data_file:file r_file_perms;
# libgps creates the pipes to glgps (.gps.interface.pipe.*) itself
allow hal_gnss_default gps_data_file:fifo_file create_file_perms;

# The gnss 1.0 service opens /dev/vndbinder at start
vndbinder_use(hal_gnss_default)
