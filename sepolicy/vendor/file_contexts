# Labels for the NVIDIA Shield Tablet family (t124, non-treble: vendor lives
# in /system/vendor).

# The shared nvidia file_contexts only use "/vendor/...". On this device the
# files are installed as /system/vendor/..., so those labels never applied and
# the services ran unlabeled (init: execute_no_trans on vendor_file).
# Mirrored automatically from device/nvidia/sepolicy/tegra/{common,lineage}.
/(vendor|system/vendor)/firmware/rtl.*_config			u:object_r:vendor_firmware_wifi_file:s0
/(vendor|system/vendor)/firmware/rtl.*_fw			u:object_r:vendor_firmware_wifi_file:s0
/(vendor|system/vendor)/firmware/rtl.*_setting\.bin		u:object_r:vendor_firmware_wifi_file:s0
/(vendor|system/vendor)/bin/init_tegra		u:object_r:init_tegra_exec:s0
/(vendor|system/vendor)/bin/cecutil		u:object_r:cecutil_exec:s0
/(vendor|system/vendor)/bin/check_eks		u:object_r:factory_tests_exec:s0
/(vendor|system/vendor)/bin/config_cameras.sh		u:object_r:config_cameras_exec:s0
/(vendor|system/vendor)/bin/dx_provTest		u:object_r:factory_tests_exec:s0
/(vendor|system/vendor)/bin/eks_hdcprx		u:object_r:factory_tests_exec:s0
/(vendor|system/vendor)/bin/factory_tests		u:object_r:factory_tests_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.boot@1\.0-binderized-service		u:object_r:hal_bootctl_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.drm@1\.1-service\.clearkey		u:object_r:hal_drm_clearkey_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.drm@1\.3-service\.clearkey		u:object_r:hal_drm_clearkey_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.drm@1\.1-service\.playready		u:object_r:hal_drm_playready_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.drm@1\.1-service\.widevine		u:object_r:hal_drm_widevine_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.drm@1\.3-service\.widevine		u:object_r:hal_drm_widevine_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.dumpstate@1\.0-service.nv		u:object_r:hal_dumpstate_impl_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.health@2\.0-service\.nv		u:object_r:hal_health_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.keymaster@3\.0-service\.tegra		u:object_r:hal_keymaster_tegra_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.nvidia\.hardware\.convertibleport@1\.0-service		u:object_r:hal_convertibleport_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.nvidia\.hardware\.cpl\.service@1\.0-service		u:object_r:hal_cplservice_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.nvidia\.hardware\.cpl\.service_common@1\.0-service	u:object_r:hal_cpl_service_common_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.nvidia\.hardware\.gensysfs@1\.0-service		u:object_r:hal_gensysfs_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.nvidia\.hardware\.ipprotect@1\.0-service		u:object_r:hal_ipprotect_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.nvidia\.hardware\.media\.vndsvc@1\.0-service		u:object_r:hal_mediavndsvc_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.nvidia\.hardware\.shieldtech\.rpx@1\.0-service		u:object_r:hal_rpx_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.nvidia\.hardware\.thermalservice@1\.0-service		u:object_r:hal_thermalservice_default_exec:s0
/(vendor|system/vendor)/bin/memfragd		u:object_r:memfragd_exec:s0
/(vendor|system/vendor)/firmware/brcmfmac4356-pcie.*		u:object_r:vendor_firmware_wifi_file:s0
/(vendor|system/vendor)/firmware/fw_bcmdhd.*		u:object_r:vendor_firmware_wifi_file:s0
/(vendor|system/vendor)/firmware/gm20b(/.*)?		u:object_r:vendor_firmware_gpu_file:s0
/(vendor|system/vendor)/firmware/im501.*		u:object_r:vendor_firmware_im501_file:s0
/(vendor|system/vendor)/firmware/nvram.*		u:object_r:vendor_firmware_wifi_file:s0

# The tablet uses the AOSP composer service in front of the nvidia HWC1;
# run it in the nvidia composer domain that has the rules it needs.
/(vendor|system/vendor)/bin/hw/android\.hardware\.graphics\.composer@2\.1-service	u:object_r:hal_graphics_composer_tegra_exec:s0

# Devices
/dev/tegra_avpchannel		u:object_r:nvavp_device:s0
/dev/ttyTHS2			u:object_r:hci_attach_dev:s0
# PHS hint shim, loaded by libEGL_tegra in every process (like libnvphs.so)
/(vendor|system/vendor)/lib/libnvphs_shim\.so	u:object_r:same_process_hal_file:s0
# Camera sensors (rear ov5693 with ad5823 focuser, front ov5693.1)
/dev/ov5693(\.1)?		u:object_r:camera_device:s0

# Sensors HAL as a binderized service (was passthrough in system_server, which
# may not open /dev/iio:device* on Android 11)
/(vendor|system/vendor)/bin/hw/android\.hardware\.sensors@1\.0-service	u:object_r:hal_sensors_tegra_exec:s0

# sysfs: the shared nvidia file_contexts label all of /sys/devices/platform as
# sysfs_device_platform (and restorecon applies that over genfscon), and their
# display entries use the t210 path /sys/devices/50000000.host1x. More specific
# entries for the t124 paths:
/sys/devices/platform/host1x/tegradc\.[0-1](/.*)?				u:object_r:sysfs_disp_dev:s0
/sys/devices/platform/gk20a\.0(/.*)?					u:object_r:sysfs_tegra_gpu:s0
/sys/devices/platform/pwm-backlight/backlight(/.*)?			u:object_r:sysfs_class_backlight:s0
/sys/devices/platform/psy_extcon\.30/power_supply(/.*)?			u:object_r:sysfs_batteryinfo:s0
/sys/devices/platform/7000c400\.i2c/i2c-1/1-000b/power_supply(/.*)?	u:object_r:sysfs_batteryinfo:s0
/sys/devices/platform/7000c400\.i2c/i2c-1/1-006b/power_supply(/.*)?	u:object_r:sysfs_batteryinfo:s0

# GPS: BCM4752 on UART-B, standby on GPIO 61 (exported by init.tn8.rc),
# glgps keeps its pipes and LTO data in /data/system/gps (fixed in the blob)
/dev/ttyTHS1							u:object_r:gps_device:s0
/dev/socket/gps							u:object_r:gps_socket:s0
/(vendor|system/vendor)/bin/glgps_nvidiaTegra2android		u:object_r:gpsd_exec:s0
/data/system/gps(/.*)?						u:object_r:gps_data_file:s0
/sys/devices/platform/6000d000\.gpio/gpio/gpio61/value		u:object_r:sysfs_gps:s0

# Wi-Fi regulatory region switch (init.wifi_region.rc)
/sys/module/bcmdhd/parameters/nvram_path	u:object_r:sysfs_wlan_fwpath:s0
